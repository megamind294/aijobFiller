[Unit]
Description=JobPilot discovery and resume preparation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jobpilot
Group=jobpilot
WorkingDirectory=/opt/aijobFiller
ExecStart=/opt/aijobFiller/.venv/bin/python -m jobpilot --home /var/lib/jobpilot watch --interval 1200 --prepare
Restart=always
RestartSec=30
StateDirectory=jobpilot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jobpilot

[Install]
WantedBy=multi-user.target
